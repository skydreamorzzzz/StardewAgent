{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.stardew-agent/actions.schema.json",
  "title": "Bootstrap primitive action registry",
  "$defs": {
    "BoundedMoveArgs": {
      "type": "object",
      "required": ["direction", "max_ticks", "max_duration_ms"],
      "properties": {
        "direction": {"enum": ["up", "down", "left", "right"]},
        "max_ticks": {"type": "integer", "minimum": 1, "maximum": 120},
        "max_duration_ms": {"type": "integer", "minimum": 50, "maximum": 5000}
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "actions": {
      "type": "array",
      "items": {
        "enum": [
          "movement.bounded",
          "input.move_up",
          "input.move_right",
          "input.move_down",
          "input.move_left",
          "input.action",
          "input.use_tool"
        ]
      }
    }
  }
}
